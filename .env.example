# Supabase project values. The URL and publishable key are safe for browser use.
# Replace with your actual Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
# Server-side issuer/JWKS validation uses the project origin above.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server-only Postgres connection string from Supabase Dashboard > Connect.
# Prefer direct or session pooling for this long-lived FastAPI process; keep the
# password URL-encoded. Never use the transaction pooler for migration jobs.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# Keep the Supabase-provided `require` mode unless a CA bundle is mounted.
# Set to verify-full together with SUPABASE_DB_SSLROOTCERT for hostname verification.
PLUS_DB_SSLMODE=require
SUPABASE_DB_SSLROOTCERT=
PLUS_DB_POOL_SIZE=5
PLUS_DB_MAX_OVERFLOW=5
PLUS_DB_STATEMENT_TIMEOUT_MS=15000

# Optional exact public HTTPS origins; callback URL must also be whitelisted in
# Supabase Authentication > URL Configuration.
PLUS11_AUTH_ALLOWED_ORIGINS=http://localhost:3000

# Next.js BFF -> private FastAPI listener. Python binds loopback only.
PLUS_API_BASE_URL=http://127.0.0.1:8001
PLUS_API_PORT=8001

# Local development defaults to an isolated SQLite file and prepares its schema
# on first run. Production schema migration remains opt-in and operator-run.
PLUS_ENV=development
PLUS_RUN_MIGRATIONS=1

# Legacy ID-only student endpoints remain disabled for real account data.
PLUS_REAL_STUDENT_DATA=1
PLUS_REQUIRE_STUDENT_IDENTITY=1
