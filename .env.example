# Manus OAuth/session values are configured by the managed project at runtime.
# Never expose MANUS_JWT_SECRET, MANUS_CLIENT_SECRET, or DATABASE_URL to the browser.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_CLIENT_ID=
MANUS_CLIENT_SECRET=
# Manus OAuth endpoints are provisioned for the deployed app.
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# Next.js BFF -> private FastAPI listener. The Python service binds loopback only.
PLUS_API_BASE_URL=http://127.0.0.1:8001
PLUS_API_PORT=8001

# Managed MySQL provides DATABASE_URL. Local development defaults to an isolated
# SQLite file; do not use the shared managed DB for tests. Run `pnpm db:migrate`
# explicitly when a managed database's schema needs to be upgraded.
DATABASE_URL=
PLUS_DATABASE_URL=
PLUS_MYSQL_SSL_CA=

# Local SQLite development applies schema preparation on first run. Production
# defaults to no startup migration; enable only after reviewing the target/code.
PLUS_RUN_MIGRATIONS=1

# Legacy ID-only student endpoints remain disabled for real account data.
PLUS_REAL_STUDENT_DATA=1
PLUS_REQUIRE_STUDENT_IDENTITY=1

# Optional exact public HTTPS origins for production Manus OAuth.
PLUS11_AUTH_ALLOWED_ORIGINS=
